{
  "name": "personal-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:github-pwa": "next build apps/github-pwa",
    "build:cloudflare-pwa": "next build apps/github-pwa",
    "dev:cloudflare": "wrangler dev --config apps/auth-worker/wrangler.jsonc",
    "deploy:cloudflare:preview": "pnpm build:cloudflare-pwa && wrangler deploy --config apps/auth-worker/wrangler.jsonc",
    "backup": "node scripts/backup.mjs",
    "backup:encrypt": "node scripts/encrypt-backup.ts",
    "backup:decrypt": "node scripts/decrypt-backup.ts",
    "restore": "node scripts/restore.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "fflate": "0.8.3",
    "lucide-react": "1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.2",
    "typescript": "^5.9.0",
    "vitest": "4.1.11",
    "wrangler": "^4.125.0"
  }
}
