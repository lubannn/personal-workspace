{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "personal-workspace",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "assets": {
    "directory": "../github-pwa/out",
    "binding": "ASSETS",
    "run_worker_first": ["/health", "/auth/*"]
  }
}
