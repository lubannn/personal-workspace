{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nexus",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "GITHUB_CLIENT_ID": "Iv23liMKCWS5z7czUAyl",
    "ALLOWED_GITHUB_LOGIN": "lubannn",
    "ALLOWED_REPO_OWNER": "lubannn",
    "ALLOWED_REPO_NAME": "personal-workspace-data",
    "COROS_MCP_RESOURCE_URL": "https://mcpcn.coros.com/mcp",
    "COROS_CALLBACK_ORIGIN": "https://nexus.lubannn.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-workspace-auth",
      "database_id": "53bcc3d8-77c4-47ed-83d5-bb911c1dff9c",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1
    }
  }
}
